# Standalone NMS cPanel configuration
# Copy to .env on the server only; never commit the populated file.
NODE_ENV=production
PORT=3000

# Required application protection
JWT_SECRET=replace-with-a-long-random-secret
NMS_PORTAL_PIN=replace-with-the-portal-pin

# Configure one persistence option
DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
# NMS_DATA_FILE=/home/account/private/nms-data.json
# Supabase project URL is informational for integrations; the server uses DATABASE_URL.
# SUPABASE_URL=https://project-ref.supabase.co

# Optional object storage / OAuth / analytics settings used by selected features
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
